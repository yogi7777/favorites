{
  "manifest_version": 3,
  "name": "Favorites Sidebar",
  "short_name": "Favorites",
  "description": "Open favorites.itcrm.ch in sidebar",
  "version": "1.2",
  "icons": {
    "48": "icon.png"
  },
  "action": {
    "default_icon": {
      "48": "icon.png"
    },
    "default_title": "Favorites Sidebar"
  },
  "sidebar_action": {
    "default_panel": "frame.html",
    "default_title": "Favorites Sidebar",
    "default_icon": {
      "48": "icon.png"
    },
    "open_at_install": false
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "favorites-sidebar@itcrm.ch",
      "strict_min_version": "140.0",
      "update_url": "https://itcrm.ch",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
